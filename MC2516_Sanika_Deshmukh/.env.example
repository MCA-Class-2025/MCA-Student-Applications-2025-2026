# ── Required ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional APIs ─────────────────────────────────────────────────
# 1. Open Food Facts  — NO KEY NEEDED
# 2. Calorie API      — free at https://calorieapi.com/
CALORIE_API_KEY=your_calorie_api_key_here
# 3. Edamam           — free at https://developer.edamam.com/
EDAMAM_APP_ID=your_edamam_app_id
EDAMAM_APP_KEY=your_edamam_app_key
# 4. USDA FoodData    — free at https://api.data.gov/signup/
USDA_API_KEY=your_usda_api_key
# 5. TheMealDB        — NO KEY NEEDED
# 6. MyMemory         — NO KEY NEEDED
