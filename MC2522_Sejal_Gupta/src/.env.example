# Environment Variables Template
# Copy this file to .env and insert your personal API keys

# Hugging Face API Token (used for MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7)
HF_TOKEN=your_huggingface_token_here

# Google Gemini API Key (used for Gemini LLM contextual moderation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Vision credentials path if using service account
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
