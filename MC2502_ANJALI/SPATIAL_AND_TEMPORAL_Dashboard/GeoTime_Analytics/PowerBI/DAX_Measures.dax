-- Date table
DateTable = CALENDAR(DATE(2021,1,1), DATE(2025,12,31))
-- Calculated columns on DateTable
Year = YEAR(DateTable[Date])
Month = FORMAT(DateTable[Date], "MMMM")
MonthNumber = MONTH(DateTable[Date])
Quarter = "Q" & FORMAT(DateTable[Date], "Q")
DayName = FORMAT(DateTable[Date], "dddd")
-- Relationship: DateTable[Date] -> Earthquakes[EventDate]. Mark DateTable as date table.
-- Sort Month by MonthNumber; DayName by weekday_num.
Total Earthquakes = DISTINCTCOUNT(Earthquakes[id])
Average Magnitude = AVERAGE(Earthquakes[mag])
Maximum Magnitude = MAX(Earthquakes[mag])
Average Depth = AVERAGE(Earthquakes[depth])
Major Earthquakes = CALCULATE([Total Earthquakes], Earthquakes[mag] >= 5)
Severe Earthquakes = CALCULATE([Total Earthquakes], Earthquakes[mag] >= 6)
Tsunami Flagged Events = CALCULATE([Total Earthquakes], Earthquakes[tsunami] = 1)
Tsunami Flagged Percentage = DIVIDE([Tsunami Flagged Events], [Total Earthquakes], 0)
Average Daily Events = AVERAGEX(VALUES(DateTable[Date]), CALCULATE([Total Earthquakes]))
